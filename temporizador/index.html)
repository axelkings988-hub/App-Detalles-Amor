<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Mensaje con Temporizador - Crear</title>

    <!-- Tailwind CSS & Icons -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <!-- Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        amberCustom: { 800: '#78350F', 900: '#451A03', 950: '#260B02' }
                    },
                    fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: linear-gradient(135deg, #260B02 0%, #451A03 50%, #78350F 100%); color: #FEF3C7; min-height: 100vh; }
    </style>
</head>
<body class="p-4 flex flex-col items-center justify-center min-h-screen">

    <!-- DASHBOARD Y FORMULARIO TEMPORIZADOR -->
    <div id="tempDashboard" class="w-full max-w-md bg-amberCustom-900/60 backdrop-blur-xl border border-amber-500/20 p-6 rounded-3xl shadow-2xl space-y-6 my-6">
        <div class="flex items-center justify-between">
            <a href="../index.html" class="text-xs text-amber-300 bg-amberCustom-950/80 px-3 py-1.5 rounded-xl border border-amber-500/30 flex items-center gap-1.5">
                <i class="fas fa-arrow-left"></i> Menú
            </a>
            <h1 class="text-lg font-bold text-amber-100">Mensaje Temporizado ⏳</h1>
            <div class="w-8"></div>
        </div>

        <form id="tempForm" onsubmit="event.preventDefault(); guardarProyectoTemporizador();" class="space-y-4">
            <div class="space-y-1">
                <label class="text-xs font-semibold text-amber-200">1. NOMBRE DEL PROYECTO:</label>
                <input type="text" id="nombreProyecto" placeholder="Ej. Cumpleaños de Sofía" required class="w-full px-4 py-2.5 rounded-xl bg-amberCustom-950/80 border border-amber-500/30 text-xs text-amber-100 placeholder-amber-400/50 focus:outline-none">
            </div>

            <div class="space-y-1">
                <label class="text-xs font-semibold text-amber-200">2. TITULO DE LA SORPRESA:</label>
                <input type="text" id="tituloMensaje" placeholder="Ej. ¡Feliz Cumpleaños!" required class="w-full px-4 py-2.5 rounded-xl bg-amberCustom-950/80 border border-amber-500/30 text-xs text-amber-100 placeholder-amber-400/50 focus:outline-none">
            </div>

            <div class="space-y-1">
                <label class="text-xs font-semibold text-amber-200">3. FECHA Y HORA DE APERTURA:</label>
                <input type="datetime-local" id="fechaApertura" required class="w-full px-4 py-2.5 rounded-xl bg-amberCustom-950/80 border border-amber-500/30 text-xs text-amber-100 focus:outline-none">
            </div>

            <div class="space-y-1">
                <label class="text-xs font-semibold text-amber-200">4. MENSAJE OCULTO:</label>
                <textarea id="mensajeOculto" rows="4" placeholder="Escribe tu carta o mensaje especial que se revelará cuando el reloj llegue a cero..." required class="w-full px-4 py-2.5 rounded-xl bg-amberCustom-950/80 border border-amber-500/30 text-xs text-amber-100 placeholder-amber-400/50 focus:outline-none resize-none"></textarea>
            </div>

            <button type="submit" id="saveTempBtn" class="w-full py-3 bg-gradient-to-r from-amber-500 to-amber-600 text-white text-xs font-bold uppercase tracking-wider rounded-xl shadow-lg active:scale-95 transition-transform flex items-center justify-center gap-2">
                ⏳ Guardar y Generar QR
            </button>
        </form>

        <div id="tempResultBox" class="hidden bg-amberCustom-950/90 border border-amber-500/30 p-5 rounded-2xl text-center space-y-4">
            <h3 class="text-xs font-bold text-amber-200">¡Temporizador Creado con Éxito! 🎉</h3>
            <div class="bg-white p-3 rounded-xl inline-block">
                <div id="tempQrcode"></div>
            </div>
            <a id="tempFinalLink" href="#" target="_blank" class="block w-full py-2 bg-amber-600 text-white text-xs font-semibold rounded-xl truncate">
                Ver Página del Temporizador
            </a>
        </div>
    </div>

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyC-PGLDqJ2GLfm3ZaXdSxxlvm8MerM1nJY",
            authDomain: "appdetallesamor.firebaseapp.com",
            projectId: "appdetallesamor",
            storageBucket: "appdetallesamor.firebasestorage.app",
            messagingSenderId: "917968456649",
            appId: "1:917968456649:web:32261e841942825685b618"
        };
        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();

        async function guardarProyectoTemporizador() {
            const nombre = document.getElementById('nombreProyecto').value.trim();
            const titulo = document.getElementById('tituloMensaje').value.trim();
            const fechaHora = document.getElementById('fechaApertura').value;
            const mensaje = document.getElementById('mensajeOculto').value.trim();

            const btn = document.getElementById('saveTempBtn');
            btn.innerText = "Guardando...";
            btn.disabled = true;

            try {
                const docRef = await db.collection("temporizadores").add({
                    nombreProyecto: nombre,
                    titulo: titulo,
                    targetDate: new Date(fechaHora).toISOString(),
                    mensaje: mensaje,
                    creado: firebase.firestore.FieldValue.serverTimestamp()
                });

                const finalLink = `https://axelkings988-hub.github.io/App-Detalles-Amor/temporizador/ver.html?id=${docRef.id}`;
                document.getElementById('tempFinalLink').href = finalLink;

                document.getElementById('tempQrcode').innerHTML = "";
                new QRCode(document.getElementById("tempQrcode"), { text: finalLink, width: 150, height: 150 });

                document.getElementById('tempResultBox').classList.remove('hidden');
                btn.innerText = "⏳ Guardar y Generar QR";
                btn.disabled = false;
            } catch (error) {
                alert("Error al guardar el temporizador.");
                btn.innerText = "⏳ Guardar y Generar QR";
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
