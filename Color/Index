
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sorteos de Colores | Dilo D' QRazón</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Plus+Jakarta+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <!-- Librería para generar QR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <!-- Firebase SDK Compat -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        serif: ['"Cinzel"', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);
            color: #F3F4F6;
            min-height: 100vh;
        }
        .font-serif { font-family: 'Cinzel', serif; }
    </style>
</head>
<body class="antialiased pb-16 px-4 pt-6">

    <main class="max-w-md mx-auto space-y-5">
        <!-- Encabezado -->
        <div class="text-center space-y-1">
            <span class="text-[10px] uppercase tracking-widest text-amber-400 font-bold bg-amber-500/10 border border-amber-500/30 px-3 py-1 rounded-full">
                Dilo D' QRazón
            </span>
            <h1 class="text-2xl font-serif font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-pink-300 to-indigo-300 pt-2">
                Sorteo de Colores
            </h1>
            <p class="text-xs text-slate-300">
                Asigna colores únicos sin repetición mediante un enlace o código QR.
            </p>
        </div>

        <!-- VISTA 1: LISTA DE PROYECTOS / CREAR NUEVO -->
        <div id="homeSection" class="space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="text-xs font-bold uppercase tracking-wider text-amber-400">Tus Proyectos Creados</h2>
                <button onclick="mostrarFormularioNuevo()" 
                    class="px-3 py-1.5 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-slate-950 font-bold text-xs rounded-xl shadow transition-all cursor-pointer flex items-center gap-1.5">
                    <i class="fas fa-plus"></i> Nuevo Proyecto
                </button>
            </div>

            <!-- Contenedor de proyectos guardados localmente -->
            <div id="proyectosContainer" class="space-y-2.5">
                <!-- Se llena con JS -->
            </div>
            
            <div id="noProjectsMsg" class="hidden bg-slate-900/60 border border-slate-800 rounded-2xl p-6 text-center space-y-2">
                <i class="fas fa-folder-open text-slate-500 text-2xl"></i>
                <p class="text-xs text-slate-400">Aún no has creado ningún sorteo de colores en este dispositivo.</p>
            </div>
        </div>

        <!-- VISTA 2: FORMULARIO DE NUEVO PROYECTO -->
        <div id="formSection" class="hidden bg-slate-900/80 backdrop-blur-xl border border-indigo-500/30 rounded-3xl p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between pb-1 border-b border-slate-800">
                <h2 class="text-sm font-serif font-bold text-white"><i class="fas fa-plus-circle text-amber-400 mr-1.5"></i> Crear Nueva Dinámica</h2>
                <button onclick="volverAlHome()" class="text-xs text-slate-400 hover:text-white cursor-pointer">
                    <i class="fas fa-arrow-left mr-1"></i> Volver
                </button>
            </div>
            
            <div class="space-y-1">
                <label class="text-xs font-bold text-amber-400">Nombre de la Dinámica / Objeto</label>
                <input type="text" id="tituloDinamica" placeholder="Ej. Intercambio de termos, Rifa sorpresa..." 
                    class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-amber-400">
            </div>

            <div class="space-y-1">
                <label class="text-xs font-bold text-amber-400 flex justify-between">
                    <span>Cantidad de Colores (Máx. 10)</span>
                    <span id="contadorLabel" class="text-indigo-300">5 colores</span>
                </label>
                <input type="range" id="cantidadColores" min="2" max="10" value="5" oninput="actualizarListaInputs()"
                    class="w-full accent-amber-400 cursor-pointer">
            </div>

            <div class="space-y-2 pt-1">
                <label class="text-xs font-bold text-amber-400 block">Personaliza los Colores</label>
                <div id="coloresInputsContainer" class="space-y-2 max-h-60 overflow-y-auto pr-1">
                    <!-- Se llena dinámicamente con JS -->
                </div>
            </div>

            <button onclick="crearDinamica()" id="btnCrear" 
                class="w-full py-3.5 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-slate-950 font-bold text-xs rounded-xl shadow-lg transition-all cursor-pointer flex items-center justify-center gap-2">
                <i class="fas fa-qrcode"></i> Guardar y Generar QR
            </button>
        </div>

        <!-- VISTA 3: RESULTADO (LINK Y QR DEL PROYECTO RECIÉN CREADO) -->
        <div id="resultSection" class="hidden bg-slate-900/90 backdrop-blur-xl border border-emerald-500/40 rounded-3xl p-6 shadow-2xl text-center space-y-5">
            <div class="w-12 h-12 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center mx-auto text-xl">
                <i class="fas fa-check"></i>
            </div>
            
            <div class="space-y-1">
                <h2 class="text-lg font-serif font-bold text-white">¡Dinámica Lista!</h2>
                <p class="text-xs text-slate-300">Comparte este QR o enlace. Cada invitado recibirá un color único.</p>
            </div>

            <div class="bg-white p-4 rounded-2xl inline-block mx-auto shadow-lg">
                <div id="qrcode"></div>
            </div>

            <div class="space-y-2 text-left">
                <label class="text-[10px] font-bold text-amber-400 uppercase tracking-wider">Enlace para Invitados</label>
                <div class="flex gap-2">
                    <input type="text" id="shareLinkInput" readonly 
                        class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-200 focus:outline-none">
                    <button onclick="copiarEnlace()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl shrink-0 cursor-pointer">
                        <i class="fas fa-copy"></i>
                    </button>
                </div>
            </div>

            <div class="pt-2 flex flex-col gap-2">
                <a id="btnProbarEnlace" href="#" target="_blank" 
                    class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl transition-colors">
                    <i class="fas fa-external-link-alt mr-1"></i> Abrir Vista de Invitado
                </a>
                <button onclick="volverAlHome()" class="text-xs text-slate-400 hover:text-white underline py-1 cursor-pointer">
                    Ir a mis proyectos
                </button>
            </div>
        </div>
    </main>

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyC-PGLDqJ2GLfm3ZaXdSxxlvm8MerM1nJY",
            authDomain: "appdetallesamor.firebaseapp.com",
            projectId: "appdetallesamor",
            storageBucket: "appdetallesamor.firebasestorage.app",
            messagingSenderId: "917968456649",
            appId: "1:917968456649:web:32261e841942825685b618",
            measurementId: "G-ZTGDLNQXSF"
        };
        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();

        const paletaDefault = [
            { nombre: "Rojo Pasión", hex: "#EF4444" },
            { nombre: "Azul Rey", hex: "#3B82F6" },
            { nombre: "Verde Esmeralda", hex: "#10B981" },
            { nombre: "Amarillo Sol", hex: "#F59E0B" },
            { nombre: "Morado Místico", hex: "#8B5CF6" },
            { nombre: "Rosa Mexicano", hex: "#EC4899" },
            { nombre: "Naranja Vibrante", hex: "#F97316" },
            { nombre: "Turquesa", hex: "#06B6D4" },
            { nombre: "Blanco Perla", hex: "#F8FAFC" },
            { nombre: "Negro Elegante", hex: "#1E293B" }
        ];

        // Cargar proyectos guardados en localStorage al iniciar
        document.addEventListener("DOMContentLoaded", () => {
            renderizarMisProyectos();
        });

        function mostrarFormularioNuevo() {
            document.getElementById('homeSection').classList.add('hidden');
            document.getElementById('formSection').classList.remove('hidden');
            document.getElementById('resultSection').classList.add('hidden');
            actualizarListaInputs();
        }

        function volverAlHome() {
            document.getElementById('homeSection').classList.remove('hidden');
            document.getElementById('formSection').classList.add('hidden');
            document.getElementById('resultSection').classList.add('hidden');
            renderizarMisProyectos();
        }

        function renderizarMisProyectos() {
            const container = document.getElementById('proyectosContainer');
            const noMsg = document.getElementById('noProjectsMsg');
            container.innerHTML = '';

            let misProyectos = [];
            try {
                misProyectos = JSON.parse(localStorage.getItem('mis_sorteos_colores') || '[]');
            } catch(e) { misProyectos = []; }

            if (misProyectos.length === 0) {
                noMsg.classList.remove('hidden');
                return;
            }

            noMsg.classList.add('hidden');
            const baseUrl = window.location.href.substring(0, window.location.href.lastIndexOf('/') + 1);

            misProyectos.forEach((proj, idx) => {
                const shareUrl = `${baseUrl}ver.html?id=${proj.id}`;
                const card = document.createElement('div');
                card.className = "bg-slate-900/80 border border-slate-800 rounded-2xl p-3.5 flex items-center justify-between gap-3 shadow";
                card.innerHTML = `
                    <div class="space-y-0.5 overflow-hidden">
                        <h3 class="text-xs font-bold text-white truncate">${proj.titulo}</h3>
                        <p class="text-[10px] text-slate-400">Creado el ${proj.fecha || 'Reciente'}</p>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0">
                        <a href
